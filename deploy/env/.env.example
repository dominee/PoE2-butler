# -------- Environment --------
ENVIRONMENT=dev
LOG_LEVEL=INFO
PUBLIC_DOMAIN=hideoutbutler.com
APP_BASE_URL=http://app.hideoutbutler.com
API_BASE_URL=http://api.hideoutbutler.com

# Domains used by the prod compose file (see DEPLOY.md / GGG_API.md).
API_DOMAIN=api.hideoutbutler.com
APP_DOMAIN=app.hideoutbutler.com
ADMIN_DOMAIN=admin.hideoutbutler.com

# -------- Secrets (generate with: openssl rand -base64 32) --------
APP_SECRET_KEY=dev-only-change-me-dev-only-change-me-dev-only=
SESSION_SIGNING_KEY=dev-only-sign-me-dev-only-sign-me-dev-only-sig=

# -------- Postgres --------
POSTGRES_USER=poe2b
POSTGRES_PASSWORD=poe2b-dev-password
POSTGRES_DB=poe2b
DATABASE_URL=postgresql+asyncpg://poe2b:poe2b-dev-password@postgres:5432/poe2b

# -------- Redis --------
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=128mb

# -------- GGG OAuth2 --------
# Internal hostname for server-to-server token/profile calls.
GGG_OAUTH_BASE_URL=http://ggg.hideoutbutler.com
GGG_API_BASE_URL=http://ggg.hideoutbutler.com
# Browser-facing authorize URL (leave empty in prod — same as GGG_OAUTH_BASE_URL).
# In dev override to the Traefik-routed hostname: http://ggg.hideoutbutler.com
GGG_OAUTH_AUTHORIZE_BASE_URL=
GGG_CLIENT_ID=poe2-butler-dev
GGG_CLIENT_SECRET=poe2-butler-dev-secret
# Prod: prefer app host: https://app.hideoutbutler.com/api/auth/callback (see GGG_API.md)
GGG_REDIRECT_URI=http://api.hideoutbutler.com/api/auth/callback
GGG_SCOPES=account:profile account:characters account:stashes account:leagues

# -------- CORS / frontend --------
CORS_ALLOW_ORIGINS=["http://app.hideoutbutler.com"]

# -------- Pricing (M4) --------
# Use "static" for offline/dev. For live PoE2 rates, set PRICING_SOURCE=poe_ninja and use the
# site origin ``https://poe.ninja`` (PoE2 JSON under ``/poe2/api/...``). The legacy suffix
# ``/api/data`` selects PoE1-style ``currencyoverview`` / ``itemoverview`` only.
PRICING_SOURCE=static
PRICING_BASE_URL=https://poe.ninja
# Hybrid detail-pane estimates: see docs/pricing_estimates.md
PRICING_TRADE_ESTIMATE_ENABLED=1
PRICING_SCOUT_BASE_URL=
PRICING_MIN_TRADE_LISTINGS=5
# Cap for POST /api/pricing/apprise (stash hybrid estimates; missing DB rows first then oldest).
PRICING_BACKFILL_MAX_ITEMS=40
# Max concurrent hybrid price estimates (GGG trade2) globally; default 1 keeps rate limits safe.
PRICING_MAX_CONCURRENT_ESTIMATES=1
# Arq worker parallel jobs (keep low; price work also gated by PRICING_MAX_CONCURRENT_ESTIMATES).
ARQ_MAX_JOBS=2
# Max historic character gear snapshots per character (timeline UI).
CHARACTER_SNAPSHOT_HISTORY_MAX=20
# Arq: max runtime per job (seconds) for most worker tasks (default arq 300 is too low for warm_prices, etc.).
ARQ_JOB_TIMEOUT_SECONDS=7200
# Arq: max runtime for ``backfill_item_price_estimates`` only (many items × GGG 429 backoff can exceed hours).
ARQ_BACKFILL_JOB_TIMEOUT_SECONDS=172800
# Min seconds between successful GGG trade2 calls (POST search, optional GET list/paging, GET fetch). Raise in prod.
GGG_TRADE_MIN_INTERVAL_SEC=12
# Extra seconds added to the global GGG lock after each successful trade2 call (in addition to min interval).
GGG_TRADE_EXTRA_SPACING_SEC=5
# On HTTP 429: wait = parsed "Please wait N seconds" + buffer; else fallback (seconds).
GGG_TRADE_429_BUFFER_SEC=15
GGG_TRADE_429_FALLBACK_SEC=300
GGG_TRADE_429_MAX_WAIT_SEC=600
# Used when PRICING_SOURCE is not poe_ninja (rough chaos conversion for trade API)
TRADE_LISTING_DIVINE_TO_CHAOS=250
TRADE_LISTING_EXALT_TO_CHAOS=8
DEFAULT_VALUABLE_THRESHOLD_CHAOS=100

# -------- Admin (M5) --------
ADMIN_USERNAME=admin
# Generate a bcrypt hash with:
#   python -c 'import bcrypt; print(bcrypt.hashpw(b"yourpass", bcrypt.gensalt()).decode())'
# bcrypt hashes contain ``$``. For this repo, ``deploy/env/.env.*`` is both compose
# ``--env-file`` and service ``env_file``; Compose interpolates ``$``, so write each
# literal ``$`` as ``$$`` (no quotes around the value, or ``$$`` will not unescape).
# Same idea if you pass the hash only via ``environment: ${ADMIN_PASSWORD_HASH}``.
ADMIN_PASSWORD_HASH=$$2b$$12$$kf1Sh4imysin12trFxWc6uhSuXCR4JUySGOwKgYR9Kn8y4obxEiYu
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=dev-session-secret-change-me
ADMIN_IP_ALLOWLIST=[]

# UAT (mock GGG + public HTTPS): see deploy/env/.env.uat.example and DEPLOY.md §4.6.

# -------- Operations / contact (prod; optional) --------
# Used for runbooks and responsible disclosure; not read by the app.
SECURITY_CONTACT_EMAIL=ops@example.com

# -------- Container registry --------
GITHUB_OWNER=your-github-username
IMAGE_TAG=latest
