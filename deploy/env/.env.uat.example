# UAT: live GGG OAuth2 + public HTTPS (Cloudflare → origin with Origin CA certificate).
# Copy to deploy/env/.env.uat and fill in secrets. See DEPLOY.md (UAT section).
#
# DNS: *.uat.hideoutbutler.com must resolve to 127.0.0.1 on the development machine
# (add entries to /etc/hosts). No mock-ggg service in this stack — real GGG OAuth2.

# -------- Environment --------
ENVIRONMENT=uat
LOG_LEVEL=INFO
PUBLIC_DOMAIN=uat.hideoutbutler.com
# App host serves SPA and (via Traefik) /api on the same origin.
APP_BASE_URL=https://app.uat.hideoutbutler.com
API_BASE_URL=https://app.uat.hideoutbutler.com

# Not used by UAT compose (no Traefik Docker provider) — placeholder for parity.
API_DOMAIN=api.uat.hideoutbutler.com
APP_DOMAIN=app.uat.hideoutbutler.com
ADMIN_DOMAIN=admin.uat.hideoutbutler.com

# -------- Secrets (generate with: openssl rand -base64 32) --------
APP_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
SESSION_SIGNING_KEY=change-me-generate-with-openssl-rand-base64-32

# -------- Postgres --------
POSTGRES_USER=poe2b
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=poe2b
DATABASE_URL=postgresql+asyncpg://poe2b:change-me-strong@postgres:5432/poe2b

# -------- Redis --------
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=128mb

# -------- GGG OAuth2 (live) --------
# Server-to-server: token exchange and API calls go to real GGG.
GGG_OAUTH_BASE_URL=https://www.pathofexile.com
GGG_API_BASE_URL=https://api.pathofexile.com
# Browser-facing authorize base URL: empty = same as GGG_OAUTH_BASE_URL (correct for live GGG).
GGG_OAUTH_AUTHORIZE_BASE_URL=
# Real credentials from GGG developer portal — never commit to git.
GGG_CLIENT_ID=your-client-id-here
GGG_CLIENT_SECRET=your-client-secret-here
# Registered redirect URI — must match exactly what GGG has on file.
GGG_REDIRECT_URI=https://app.uat.hideoutbutler.com/api/auth/callback
# Only the scopes GGG has granted; requesting undeclared scopes will fail auth.
# account:stashes is PoE1-only and not yet available for PoE2. account:leagues
# was not granted — leagues are inferred from the character list instead.
GGG_SCOPES=account:profile account:characters
# PoE2 realm segment for character API (GET /character/poe2). Required for live GGG.
GGG_API_REALM=poe2
# Fallback when account:leagues is unavailable; update each new challenge league.
GGG_DEFAULT_LEAGUE=Runes of Aldur

# -------- CORS / frontend --------
CORS_ALLOW_ORIGINS=["https://app.uat.hideoutbutler.com"]

# -------- Pricing --------
PRICING_SOURCE=poe_ninja
PRICING_BASE_URL=https://poe.ninja
DEFAULT_VALUABLE_THRESHOLD_CHAOS=100
PRICING_MAX_CONCURRENT_ESTIMATES=1
ARQ_MAX_JOBS=2
CHARACTER_SNAPSHOT_HISTORY_MAX=20

# -------- Admin --------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$$2b$$12$$kf1Sh4imysin12trFxWc6uhSuXCR4JUySGOwKgYR9Kn8y4obxEiYu
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=change-me
ADMIN_IP_ALLOWLIST=[]

# Operator actions (must match backend ADMIN_INTERNAL_SECRET).
ADMIN_INTERNAL_SECRET=

# -------- Operations --------
SECURITY_CONTACT_EMAIL=ops@example.com
TRAEFIK_ACME_EMAIL=ops@example.com

# -------- Container registry (optional, not required for local UAT) --------
GITHUB_OWNER=your-github-username
IMAGE_TAG=latest
